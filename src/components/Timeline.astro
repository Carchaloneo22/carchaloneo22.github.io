---
import { jobs, person, skills } from '../data/profile';
const VISIBLE = 7;
---

<section id="trayectoria" class="section trayectoria" aria-labelledby="trayectoria-title">
  <div class="wrap">
    <header class="section-head">
      <h2 id="trayectoria-title">Trayectoria</h2>
      {person.about.map((p) => <p>{p}</p>)}
    </header>

    <div class="layout">
      <div>
        <ol class="timeline" id="lista-trayectoria" data-timeline>
          {
            jobs.map((j, i) => (
              <li class:list={['job', { extra: i >= VISIBLE }]}>
                <p class="period">{j.period}</p>
                <div class="job-body">
                  <h3>{j.role}</h3>
                  <p class="org">{j.org}</p>
                  <p class="detail">{j.detail}</p>
                </div>
              </li>
            ))
          }
        </ol>
        <button
          type="button"
          class="btn btn-ghost more"
          aria-expanded="false"
          aria-controls="lista-trayectoria"
          data-more
        >
          Ver la trayectoria completa ({jobs.length} cargos)
        </button>
      </div>

      <aside class="skills" aria-labelledby="skills-title">
        <h3 id="skills-title">Herramientas</h3>
        {
          skills.map((s) => (
            <div class="skill-group">
              <h4>{s.group}</h4>
              <ul>
                {s.items.map((it) => (
                  <li class="chip">{it}</li>
                ))}
              </ul>
            </div>
          ))
        }
        <blockquote>
          <p>“{person.quote}”</p>
        </blockquote>
      </aside>
    </div>
  </div>
</section>

<style>
  .trayectoria {
    overflow-x: clip;
    background: var(--surface);
    border-block: 1px solid var(--line);
  }
  .section-head p {
    font-size: var(--step-0);
    line-height: 1.6;
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 22rem);
    gap: clamp(2rem, 5vw, 5rem);
    align-items: start;
  }
  .timeline {
    --rail: 7.5rem;
    position: relative;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .timeline::before,
  .timeline::after {
    content: '';
    position: absolute;
    left: calc(var(--rail) + 0.5rem);
    top: 0.6rem;
    bottom: 0.6rem;
    width: 2px;
    background: var(--line);
  }
  .timeline::after {
    background: linear-gradient(var(--ocre), var(--accent));
    transform-origin: top;
    transform: scaleY(var(--progress, 1));
  }
  :global(.js) .timeline::after {
    transform: scaleY(var(--progress, 0));
  }
  .job {
    display: grid;
    grid-template-columns: var(--rail) 1fr;
    gap: 1.75rem;
    padding-bottom: 2rem;
    position: relative;
  }
  .job::before {
    content: '';
    position: absolute;
    left: calc(var(--rail) + 0.5rem - 5px);
    top: 0.45rem;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--surface);
    border: 2px solid var(--ocre);
    z-index: 1;
    transition: background-color 0.4s, transform 0.5s var(--ease), box-shadow 0.6s;
  }
  .job.is-reached::before {
    background: var(--ocre);
    transform: scale(1.35);
    box-shadow: 0 0 0 6px color-mix(in srgb, var(--ocre) 22%, transparent);
  }
  :global(.js) .job .period,
  :global(.js) .job .job-body {
    opacity: 0;
    transition: opacity 0.6s ease, translate 0.7s var(--ease);
  }
  :global(.js) .job .period {
    translate: -18px 0;
  }
  :global(.js) .job .job-body {
    translate: 28px 0;
    transition-delay: 0.08s;
  }
  :global(.js) .job.is-in .period,
  :global(.js) .job.is-in .job-body {
    opacity: 1;
    translate: 0 0;
  }
  .job.is-reached .period {
    color: var(--ocre);
  }
  :global(.js) .job.extra {
    display: none;
  }
  :global(.js) .timeline.is-open .job.extra {
    display: grid;
  }
  .period {
    font-family: var(--font-display);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    color: var(--muted);
    text-align: right;
  }
  .job-body h3 {
    font-size: var(--step-1);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .org {
    color: var(--accent);
    font-weight: 700;
    margin-top: 0.15rem;
  }
  .detail {
    color: var(--muted);
    margin-top: 0.35rem;
  }
  .more {
    margin-left: calc(var(--rail, 7.5rem) + 2.25rem);
  }
  :global(html:not(.js)) .more {
    display: none;
  }

  .skills {
    position: sticky;
    top: 6rem;
    display: grid;
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: 18px;
    background: var(--bg);
    border: 1px solid var(--line);
  }
  .skills h3 {
    font-size: var(--step-2);
    font-weight: 750;
  }
  .skill-group h4 {
    margin: 0 0 0.5rem;
    font-size: var(--step--1);
    color: var(--muted);
  }
  .skill-group ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }
  blockquote {
    margin: 0.5rem 0 0;
    padding-top: 1.25rem;
    border-top: 1px solid var(--line);
    font-family: var(--font-display);
    font-size: var(--step-1);
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .job .period,
    :global(.js) .job .job-body {
      opacity: 1;
      translate: none;
    }
    :global(.js) .timeline::after {
      transform: scaleY(1);
    }
  }

  @media (max-width: 59.99rem) {
    .layout {
      grid-template-columns: 1fr;
    }
    .skills {
      position: static;
    }
  }
  @media (max-width: 35rem) {
    .timeline {
      --rail: 0rem;
      padding-left: 1.5rem;
    }
    .timeline::before,
    .timeline::after {
      left: 0.3rem;
    }
    .job {
      grid-template-columns: 1fr;
      gap: 0.25rem;
    }
    .job::before {
      left: calc(-1.5rem + 0.3rem - 5px);
    }
    .period {
      text-align: left;
    }
    .more {
      margin-left: 0;
    }
  }
</style>

<script>
  const timeline = document.querySelector<HTMLOListElement>('[data-timeline]')!;
  const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const jobsEls = Array.from(timeline.querySelectorAll<HTMLElement>('.job'));

  // Cada cargo aparece al entrar en pantalla.
  const io = new IntersectionObserver(
    (entries) =>
      entries.forEach((e) => {
        if (e.isIntersecting) {
          e.target.classList.add('is-in');
          io.unobserve(e.target);
        }
      }),
    { rootMargin: '0px 0px -12% 0px' }
  );
  jobsEls.forEach((j) => (reduceMotion ? j.classList.add('is-in', 'is-reached') : io.observe(j)));

  // La línea se llena con el scroll y enciende cada punto al pasar por él.
  if (!reduceMotion) {
    let queued = false;
    const update = () => {
      queued = false;
      const r = timeline.getBoundingClientRect();
      const mark = innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, (mark - r.top) / r.height));
      timeline.style.setProperty('--progress', p.toFixed(4));
      const lineY = r.top + p * r.height;
      jobsEls.forEach((j) => {
        if (j.offsetParent === null) return;
        j.classList.toggle('is-reached', j.getBoundingClientRect().top + 12 <= lineY);
      });
    };
    const queue = () => {
      if (!queued) {
        queued = true;
        requestAnimationFrame(update);
      }
    };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    update();
    document.addEventListener('timeline:resize', queue);
  }

  const btn = document.querySelector<HTMLButtonElement>('[data-more]');
  const list = document.querySelector<HTMLOListElement>('[data-timeline]');
  btn?.addEventListener('click', () => {
    const open = btn.getAttribute('aria-expanded') !== 'true';
    btn.setAttribute('aria-expanded', String(open));
    list!.classList.toggle('is-open', open);
    btn.textContent = open ? 'Mostrar menos' : `Ver la trayectoria completa (${list!.children.length} cargos)`;
    document.dispatchEvent(new Event('timeline:resize'));
    if (open) {
      const firstExtra = list!.querySelector<HTMLElement>('.extra h3');
      firstExtra?.setAttribute('tabindex', '-1');
      firstExtra?.focus({ preventScroll: true });
    }
  });
</script>
